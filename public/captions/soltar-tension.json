{
  "id": "soltar-tension",
  "voice": "luz",
  "duration": 600.0,
  "captions": [
    {
      "s": 4.2,
      "e": 4.81,
      "t": "Hola."
    },
    {
      "s": 5.61,
      "e": 10.76,
      "t": "Esta práctica es para esos días en que el estrés se queda atrapado en el cuerpo."
    },
    {
      "s": 11.56,
      "e": 14.65,
      "t": "En los hombros, en la mandíbula, en el estómago."
    },
    {
      "s": 15.45,
      "e": 20.44,
      "t": "Vamos a recorrer el cuerpo buscando esos lugares, y a invitarlos a soltar."
    },
    {
      "s": 21.24,
      "e": 25.28,
      "t": "No a la fuerza, sino con paciencia, como quien desata un nudo."
    },
    {
      "s": 28.28,
      "e": 30.19,
      "t": "Siéntate o recuéstate."
    },
    {
      "s": 30.99,
      "e": 32.38,
      "t": "Cierra los ojos."
    },
    {
      "s": 36.38,
      "e": 38.39,
      "t": "Inhala profundo por la nariz…"
    },
    {
      "s": 39.74,
      "e": 43.19,
      "t": "y suelta el aire por la boca, con un sonido si quieres."
    },
    {
      "s": 43.99,
      "e": 45.09,
      "t": "Un «ahh» largo."
    },
    {
      "s": 49.09,
      "e": 50.03,
      "t": "Otra vez."
    },
    {
      "s": 50.83,
      "e": 51.6,
      "t": "Inhala…"
    },
    {
      "s": 52.95,
      "e": 53.89,
      "t": "y suelta."
    },
    {
      "s": 58.89,
      "e": 64.18,
      "t": "Empecemos por la cara, donde solemos acumular mucha tensión sin darnos cuenta."
    },
    {
      "s": 64.98,
      "e": 66.28,
      "t": "Nota la frente."
    },
    {
      "s": 67.08,
      "e": 69.86,
      "t": "Si está fruncida, deja que se alise."
    },
    {
      "s": 87.33,
      "e": 88.29,
      "t": "Los ojos."
    },
    {
      "s": 89.09,
      "e": 92.97,
      "t": "Deja que se hundan un poco, suaves, dentro de sus órbitas."
    },
    {
      "s": 110.45,
      "e": 111.57,
      "t": "La mandíbula."
    },
    {
      "s": 112.37,
      "e": 115.26,
      "t": "Muchas personas la aprietan todo el día."
    },
    {
      "s": 116.06,
      "e": 118.06,
      "t": "Separa un poco los dientes."
    },
    {
      "s": 118.86,
      "e": 120.99,
      "t": "Deja que la boca se afloje."
    },
    {
      "s": 121.79,
      "e": 125.17,
      "t": "Quizás quieras abrirla y cerrarla un par de veces."
    },
    {
      "s": 160.12,
      "e": 161.39,
      "t": "Baja al cuello."
    },
    {
      "s": 162.19,
      "e": 167.64,
      "t": "Puedes moverlo suavemente de un lado a otro, muy despacio, y luego volver al centro."
    },
    {
      "s": 185.11,
      "e": 186.36,
      "t": "Ahora los hombros."
    },
    {
      "s": 187.16,
      "e": 190.15,
      "t": "Súbelos hacia las orejas, apretando fuerte…"
    },
    {
      "s": 191.5,
      "e": 193.0,
      "t": "mantén un momento…"
    },
    {
      "s": 195.0,
      "e": 196.91,
      "t": "y déjalos caer de golpe."
    },
    {
      "s": 197.71,
      "e": 199.25,
      "t": "Siente la diferencia."
    },
    {
      "s": 202.25,
      "e": 203.19,
      "t": "Otra vez."
    },
    {
      "s": 203.99,
      "e": 205.23,
      "t": "Sube los hombros…"
    },
    {
      "s": 206.58,
      "e": 207.45,
      "t": "aprieta…"
    },
    {
      "s": 209.45,
      "e": 210.39,
      "t": "y suelta."
    },
    {
      "s": 245.34,
      "e": 248.19,
      "t": "Lleva la atención a los brazos y las manos."
    },
    {
      "s": 248.99,
      "e": 252.36,
      "t": "Cierra los puños con fuerza, como si apretaras algo…"
    },
    {
      "s": 255.36,
      "e": 257.95,
      "t": "y abre las manos, extendiendo los dedos."
    },
    {
      "s": 258.75,
      "e": 260.77,
      "t": "Luego déjalas descansar."
    },
    {
      "s": 261.57,
      "e": 264.42,
      "t": "Siente el hormigueo, la sangre que circula."
    },
    {
      "s": 299.37,
      "e": 300.58,
      "t": "Ahora el pecho."
    },
    {
      "s": 301.38,
      "e": 304.51,
      "t": "Deja que la respiración lo expanda libremente."
    },
    {
      "s": 305.31,
      "e": 307.09,
      "t": "No hay nada que contener."
    },
    {
      "s": 324.56,
      "e": 325.71,
      "t": "El estómago."
    },
    {
      "s": 326.51,
      "e": 329.49,
      "t": "El estrés suele esconderse aquí, como un nudo."
    },
    {
      "s": 330.29,
      "e": 335.21,
      "t": "Respira hacia el abdomen, y deja que se ablande, que se vuelva suave y redondo."
    },
    {
      "s": 370.16,
      "e": 371.17,
      "t": "La espalda."
    },
    {
      "s": 371.97,
      "e": 377.03,
      "t": "Imagina que cada vértebra se acomoda sobre la anterior, con espacio entre ellas."
    },
    {
      "s": 394.51,
      "e": 396.18,
      "t": "Las piernas, los pies."
    },
    {
      "s": 396.98,
      "e": 398.75,
      "t": "Pesados, apoyados."
    },
    {
      "s": 399.55,
      "e": 401.4,
      "t": "Suelta los dedos de los pies."
    },
    {
      "s": 436.34,
      "e": 442.52,
      "t": "Ahora recorre todo el cuerpo de un vistazo, de la cabeza a los pies, como una ola cálida que baja."
    },
    {
      "s": 443.32,
      "e": 447.38,
      "t": "Si queda algún rincón con tensión, envíale tu respiración."
    },
    {
      "s": 499.81,
      "e": 502.96,
      "t": "Quédate un momento en este cuerpo más suelto."
    },
    {
      "s": 503.76,
      "e": 508.45,
      "t": "Recuerda cómo se siente, para poder volver a esta sensación más tarde."
    },
    {
      "s": 560.87,
      "e": 562.19,
      "t": "Vamos terminando."
    },
    {
      "s": 562.99,
      "e": 565.47,
      "t": "Haz una respiración más profunda."
    },
    {
      "s": 566.27,
      "e": 567.51,
      "t": "Mueve los dedos."
    },
    {
      "s": 568.31,
      "e": 570.07,
      "t": "Estírate lentamente."
    },
    {
      "s": 574.07,
      "e": 576.7,
      "t": "Y cuando sea el momento, abre los ojos."
    },
    {
      "s": 578.7,
      "e": 584.17,
      "t": "El cuerpo guarda lo que vivimos, pero también sabe soltarlo cuando le damos permiso."
    },
    {
      "s": 584.97,
      "e": 587.9,
      "t": "Vuelve a esta práctica cuando lo necesites."
    }
  ],
  "cues": [
    {
      "t": 0.4,
      "type": "bell"
    },
    {
      "t": 590.5,
      "type": "bell"
    }
  ]
}
