{
  "id": "energia-matinal",
  "voice": "luz",
  "duration": 360.0,
  "captions": [
    {
      "s": 4.2,
      "e": 5.3,
      "t": "Buenos días."
    },
    {
      "s": 6.1,
      "e": 11.08,
      "t": "Esta práctica es para despertar el cuerpo y la mente cuando te cuesta arrancar."
    },
    {
      "s": 11.88,
      "e": 16.71,
      "t": "Son seis minutos para pasar del sueño a la energía, sin café de por medio."
    },
    {
      "s": 17.51,
      "e": 20.52,
      "t": "Puedes hacerla de pie o en el borde de la cama."
    },
    {
      "s": 23.52,
      "e": 25.85,
      "t": "Empieza con los ojos abiertos."
    },
    {
      "s": 26.65,
      "e": 32.52,
      "t": "Estira los brazos hacia arriba, lo más alto que puedas, como si quisieras tocar el techo."
    },
    {
      "s": 35.52,
      "e": 36.46,
      "t": "Y suelta."
    },
    {
      "s": 38.46,
      "e": 39.4,
      "t": "Otra vez."
    },
    {
      "s": 40.2,
      "e": 44.49,
      "t": "Estírate hacia arriba, y ahora inclínate un poco hacia la derecha…"
    },
    {
      "s": 47.49,
      "e": 48.93,
      "t": "y hacia la izquierda."
    },
    {
      "s": 51.93,
      "e": 54.51,
      "t": "Vuelve al centro y suelta los brazos."
    },
    {
      "s": 57.51,
      "e": 60.41,
      "t": "Ahora, unas respiraciones que dan energía."
    },
    {
      "s": 61.21,
      "e": 70.05,
      "t": "Inhala profundo por la nariz, llenando bien los pulmones, y exhala rápido por la boca, con fuerza, como si apagaras una vela de un soplo."
    },
    {
      "s": 70.85,
      "e": 71.56,
      "t": "Inhala"
    },
    {
      "s": 73.06,
      "e": 74.0,
      "t": "y suelta."
    },
    {
      "s": 76.0,
      "e": 76.71,
      "t": "Inhala"
    },
    {
      "s": 78.21,
      "e": 79.15,
      "t": "y suelta."
    },
    {
      "s": 81.15,
      "e": 81.86,
      "t": "Inhala"
    },
    {
      "s": 83.36,
      "e": 84.3,
      "t": "y suelta."
    },
    {
      "s": 86.3,
      "e": 88.58,
      "t": "Tres más, un poco más rápido."
    },
    {
      "s": 89.38,
      "e": 90.09,
      "t": "Inhala"
    },
    {
      "s": 91.29,
      "e": 92.23,
      "t": "y suelta."
    },
    {
      "s": 93.23,
      "e": 93.94,
      "t": "Inhala"
    },
    {
      "s": 95.14,
      "e": 96.08,
      "t": "y suelta."
    },
    {
      "s": 97.08,
      "e": 97.79,
      "t": "Inhala"
    },
    {
      "s": 98.99,
      "e": 99.93,
      "t": "y suelta."
    },
    {
      "s": 102.93,
      "e": 105.19,
      "t": "Nota el cosquilleo en el cuerpo."
    },
    {
      "s": 105.99,
      "e": 107.6,
      "t": "La sangre que circula."
    },
    {
      "s": 108.4,
      "e": 109.95,
      "t": "El calor en las manos."
    },
    {
      "s": 144.94,
      "e": 148.96,
      "t": "Frota las palmas entre sí, con energía, hasta que se calienten."
    },
    {
      "s": 152.96,
      "e": 155.44,
      "t": "Y apóyalas sobre los ojos cerrados."
    },
    {
      "s": 156.24,
      "e": 157.49,
      "t": "Siente el calor."
    },
    {
      "s": 158.29,
      "e": 160.27,
      "t": "Descansa ahí un momento."
    },
    {
      "s": 164.27,
      "e": 166.91,
      "t": "Ahora baja las manos, y abre los ojos."
    },
    {
      "s": 167.71,
      "e": 169.3,
      "t": "Mira a tu alrededor."
    },
    {
      "s": 170.1,
      "e": 171.65,
      "t": "La luz de la mañana."
    },
    {
      "s": 172.45,
      "e": 173.44,
      "t": "Los colores."
    },
    {
      "s": 208.43,
      "e": 213.55,
      "t": "Da unos golpecitos suaves con las yemas de los dedos sobre la cabeza, como lluvia."
    },
    {
      "s": 214.35,
      "e": 217.51,
      "t": "Luego sobre los hombros, los brazos, el pecho."
    },
    {
      "s": 218.31,
      "e": 220.84,
      "t": "Despertando cada parte del cuerpo."
    },
    {
      "s": 290.82,
      "e": 295.65,
      "t": "Para terminar, piensa en una sola cosa que quieras hacer hoy con esta energía."
    },
    {
      "s": 296.45,
      "e": 298.08,
      "t": "Algo que te importe."
    },
    {
      "s": 333.07,
      "e": 337.06,
      "t": "Haz una última inhalación profunda, estirándote hacia arriba…"
    },
    {
      "s": 340.06,
      "e": 342.09,
      "t": "y suelta con una sonrisa."
    },
    {
      "s": 344.09,
      "e": 345.78,
      "t": "Tu día empieza ahora."
    },
    {
      "s": 346.58,
      "e": 347.9,
      "t": "Que lo disfrutes."
    }
  ],
