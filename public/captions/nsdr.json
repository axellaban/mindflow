      "t": "El pecho."
    },
    {
      "s": 348.35,
      "e": 349.47,
      "t": "El abdomen."
    },
    {
      "s": 350.67,
      "e": 351.79,
      "t": "El ombligo."
    },
    {
      "s": 352.99,
      "e": 353.98,
      "t": "La pelvis."
    },
    {
      "s": 356.98,
      "e": 359.47,
      "t": "Todo el lado derecho del cuerpo."
    },
    {
      "s": 361.47,
      "e": 363.25,
      "t": "Todo el lado izquierdo."
    },
    {
      "s": 365.25,
      "e": 367.2,
      "t": "Todo el cuerpo, a la vez."
    },
    {
      "s": 416.95,
      "e": 421.26,
      "t": "Siente el cuerpo entero, quieto, pesado, respirando solo."
    },
    {
      "s": 446.13,
      "e": 450.44,
      "t": "Ahora lleva la atención a la respiración, justo en el abdomen."
    },
    {
      "s": 451.24,
      "e": 452.63,
      "t": "No la controles."
    },
    {
      "s": 453.43,
      "e": 454.86,
      "t": "Solo obsérvala."
    },
    {
      "s": 455.66,
      "e": 463.23,
      "t": "Vamos a contar hacia atrás, desde veintisiete hasta uno, una cuenta por cada respiración completa."
    },
    {
      "s": 464.03,
      "e": 467.95,
      "t": "Al inhalar piensa el número, al exhalar lo sueltas."
    },
    {
      "s": 468.75,
      "e": 473.06,
      "t": "Si pierdes la cuenta, vuelve a empezar desde veintisiete."
    },
    {
      "s": 473.86,
      "e": 476.09,
      "t": "No importa cuántas veces."
    },
    {
      "s": 625.32,
      "e": 628.1,
      "t": "Suelta la cuenta, estés donde estés."
    },
    {
      "s": 652.97,
      "e": 656.45,
      "t": "Ahora vamos a explorar sensaciones opuestas."
    },
    {
      "s": 657.25,
      "e": 659.23,
      "t": "Siente el cuerpo pesado."
    },
    {
      "s": 660.03,
      "e": 661.18,
      "t": "Muy pesado."
    },
    {
      "s": 661.98,
      "e": 665.4,
      "t": "Como si fuera de plomo, hundiéndose en el suelo."
    },
    {
      "s": 690.27,
      "e": 692.88,
      "t": "Y ahora, siente el cuerpo ligero."
    },
    {
      "s": 693.68,
      "e": 694.79,
      "t": "Muy ligero."
    },
    {
      "s": 695.59,
      "e": 698.12,
      "t": "Como una pluma, casi flotando."
    },
    {
      "s": 722.99,
      "e": 723.88,
      "t": "Pesado."
    },
    {
      "s": 726.88,
      "e": 727.9,
      "t": "Y ligero."
    },
    {
      "s": 730.9,
      "e": 733.81,
      "t": "Pesado y ligero al mismo tiempo."
    },
    {
      "s": 783.56,
      "e": 785.26,
      "t": "Ahora siente calor."
    },
    {
      "s": 786.06,
      "e": 791.68,
      "t": "Imagina que estás bajo un sol de verano, tibio, agradable, sobre toda la piel."
    },
    {
      "s": 816.55,
      "e": 818.13,
      "t": "Y ahora frescura."
    },
    {
      "s": 818.93,
      "e": 823.33,
      "t": "Una brisa suave, fresca, como al lado del mar por la noche."
    },
    {
      "s": 848.2,
      "e": 848.93,
      "t": "Calor."
    },
    {
      "s": 851.93,
      "e": 852.92,
      "t": "Frescura."
    },
    {
      "s": 855.92,
      "e": 858.3,
      "t": "Las dos sensaciones a la vez."
    },
    {
      "s": 908.05,
      "e": 911.69,
      "t": "Descansa ahora en la pura sensación de estar."
    },
    {
      "s": 912.49,
      "e": 915.19,
      "t": "Sin nombre, sin tarea, sin historia."
    },
    {
      "s": 915.99,
      "e": 917.43,
      "t": "Solo presencia."
    },
    {
      "s": 918.23,
      "e": 919.77,
      "t": "Solo respiración."
    },
    {
      "s": 920.57,
      "e": 921.99,
      "t": "Solo descanso."
    },
    {
      "s": 1120.96,
      "e": 1123.65,
      "t": "Poco a poco, empieza a regresar."
    },
    {
      "s": 1126.65,
      "e": 1130.84,
      "t": "Nota la respiración, que se vuelve un poco más profunda."
    },
    {
      "s": 1133.84,
      "e": 1136.09,
      "t": "Siente el suelo bajo el cuerpo."
    },
    {
      "s": 1136.89,
      "e": 1138.95,
      "t": "Los sonidos de la habitación."
    },
    {
      "s": 1141.95,
      "e": 1145.9,
      "t": "Mueve suavemente los dedos de las manos y de los pies."
    },
    {
      "s": 1148.9,
      "e": 1152.87,
      "t": "Estírate como lo harías al despertar por la mañana."
    },
    {
      "s": 1156.87,
      "e": 1164.41,
      "t": "Cuando estés en condiciones, gira hacia un costado, y quédate ahí unos segundos antes de incorporarte."
    },
    {
      "s": 1169.41,
      "e": 1172.5,
      "t": "Y cuando sea el momento, abre los ojos."
    },
    {
      "s": 1174.5,
      "e": 1178.72,
      "t": "Regalarse un descanso profundo no es perder el tiempo."
    },
    {
      "s": 1179.52,
      "e": 1184.02,
      "t": "Es la forma en que el cuerpo y la mente recuperan su energía."
    },
    {
      "s": 1184.82,
      "e": 1187.9,
      "t": "Que el resto de tu día sea más ligero."
    }
