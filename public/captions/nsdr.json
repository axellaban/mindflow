  "captions": [
    {
      "s": 4.2,
      "e": 4.81,
      "t": "Hola."
    },
    {
      "s": 5.61,
      "e": 9.52,
      "t": "Bienvenida a esta práctica de descanso profundo."
    },
    {
      "s": 10.32,
      "e": 17.31,
      "t": "Está inspirada en el yoga nidra, y en lo que hoy se conoce como descanso profundo sin sueño."
    },
    {
      "s": 18.11,
      "e": 28.3,
      "t": "Durante veinte minutos, vas a llevar el cuerpo a un estado de reposo muy profundo, mientras la mente permanece ligeramente consciente."
    },
    {
      "s": 29.1,
      "e": 38.89,
      "t": "Es ideal para recuperar energía a media tarde, después de una mala noche, o cuando necesitas recargar sin dormir una siesta larga."
    },
    {
      "s": 41.89,
      "e": 46.83,
      "t": "Acuéstate boca arriba, sobre una cama, un sofá o una colchoneta."
    },
    {
      "s": 47.63,
      "e": 51.78,
      "t": "Deja los brazos a los lados, con las palmas hacia arriba."
    },
    {
      "s": 52.58,
      "e": 54.81,
      "t": "Separa un poco las piernas."
    },
    {
      "s": 55.61,
      "e": 58.61,
      "t": "Si hace fresco, cúbrete con una manta."
    },
    {
      "s": 59.41,
      "e": 64.1,
      "t": "La temperatura del cuerpo baja durante el descanso profundo."
    },
    {
      "s": 69.1,
      "e": 70.58,
      "t": "Cierra los ojos."
    },
    {
      "s": 73.58,
      "e": 76.54,
      "t": "Haz una inhalación larga por la nariz…"
    },
    {
      "s": 77.89,
      "e": 81.55,
      "t": "y una exhalación todavía más larga por la boca."
    },
    {
      "s": 86.55,
      "e": 87.56,
      "t": "Otra vez."
    },
    {
      "s": 88.36,
      "e": 89.15,
      "t": "Inhala…"
    },
    {
      "s": 92.15,
      "e": 95.56,
      "t": "y exhala despacio, vaciando por completo."
    },
    {
      "s": 100.56,
      "e": 102.0,
      "t": "Una última vez."
    },
    {
      "s": 108.0,
      "e": 110.6,
      "t": "Ahora deja la respiración libre."
    },
    {
      "s": 111.4,
      "e": 118.42,
      "t": "Durante esta práctica, tu única tarea es escuchar mi voz y llevar la atención adonde te indique."
    },
    {
      "s": 119.22,
      "e": 122.09,
      "t": "Si te distraes, simplemente vuelve."
    },
    {
      "s": 146.96,
      "e": 152.82,
      "t": "Vamos a recorrer el cuerpo con rapidez, como una luz que salta de un punto a otro."
    },
    {
      "s": 153.62,
      "e": 156.09,
      "t": "No hace falta relajar nada."
    },
    {
      "s": 156.89,
      "e": 160.49,
      "t": "Solo toca cada punto con la atención, y sigue."
    },
    {
      "s": 163.49,
      "e": 165.86,
