    },
    {
      "s": 255.09,
      "e": 257.84,
      "t": "Continúa con este ritmo por tu cuenta."
    },
    {
      "s": 258.64,
      "e": 261.54,
      "t": "Inhalación tranquila, exhalación larga."
    },
    {
      "s": 368.49,
      "e": 372.8,
      "t": "Si aparece un pensamiento ansioso, no tienes que discutir con él."
    },
    {
      "s": 373.6,
      "e": 377.0,
      "t": "Solo nota que está ahí, y vuelve a la exhalación larga."
    },
    {
      "s": 483.95,
      "e": 486.38,
      "t": "Quizás ya notes algún cambio."
    },
    {
      "s": 487.18,
      "e": 490.68,
      "t": "Tal vez un poco más de calma, o tal vez no mucho."
    },
    {
      "s": 491.48,
      "e": 493.61,
      "t": "Las dos cosas están bien."
    },
    {
      "s": 494.41,
      "e": 498.44,
      "t": "Esto es un entrenamiento, y el cuerpo aprende con la repetición."
    },
    {
      "s": 551.92,
      "e": 554.37,
      "t": "Deja ahora la respiración libre."
    },
    {
      "s": 555.17,
      "e": 558.4,
      "t": "Siente tus manos sobre el cuerpo una última vez."
    },
    {
      "s": 562.4,
      "e": 565.03,
      "t": "Y cuando sea el momento, abre los ojos."
    },
    {
      "s": 567.03,
      "e": 571.91,
      "t": "Hoy aprendiste el interruptor más básico: exhalar más largo de lo que inhalas."
    },
    {
      "s": 572.71,
      "e": 576.15,
      "t": "Puedes usarlo en cualquier lugar, sin que nadie lo note."
    },
    {
      "s": 576.95,
      "e": 580.44,
      "t": "En el transporte, en una reunión, antes de dormir."
    },
    {
      "s": 581.24,
      "e": 585.93,
      "t": "Mañana aprenderemos a anclarnos en el cuerpo cuando la mente se acelera."
    },
    {
      "s": 586.73,
      "e": 587.9,
      "t": "Hasta mañana."
