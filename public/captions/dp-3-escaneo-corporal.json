{
  "id": "dp-3-escaneo-corporal",
  "voice": "luz",
  "duration": 900.0,
  "captions": [
    {
      "s": 1.2,
      "e": 1.82,
      "t": "Hola."
    },
    {
      "s": 2.62,
      "e": 5.31,
      "t": "Bienvenida a la tercera noche."
    },
    {
      "s": 6.11,
      "e": 14.12,
      "t": "Esta noche vamos a recorrer el cuerpo, parte por parte, invitando a cada zona a soltarse y a descansar."
    },
    {
      "s": 14.92,
      "e": 22.58,
      "t": "Es una práctica muy eficaz para conciliar el sueño, así que no te preocupes si no llegas al final."
    },
    {
      "s": 25.58,
      "e": 30.96,
      "t": "Acuéstate boca arriba, o en la posición que te resulte más cómoda."
    },
    {
      "s": 31.76,
      "e": 35.11,
      "t": "Deja los brazos a los lados del cuerpo."
    },
    {
      "s": 35.91,
      "e": 37.77,
      "t": "Las piernas, sueltas."
    },
    {
      "s": 42.77,
      "e": 44.17,
      "t": "Respira hondo…"
    },
    {
      "s": 45.52,
      "e": 49.12,
      "t": "y deja salir el aire con un suspiro largo."
    },
    {
      "s": 54.12,
      "e": 55.38,
      "t": "Una vez más."
    },
    {
      "s": 56.18,
      "e": 57.0,
      "t": "Inhala…"
    },
    {
      "s": 60.0,
      "e": 61.06,
      "t": "y suelta."
    },
    {
      "s": 67.06,
      "e": 70.14,
      "t": "Lleva la atención a los dedos de los pies."
    },
    {
      "s": 70.94,
      "e": 76.77,
      "t": "Imagina que se vuelven pesados, muy pesados, como si fueran de arena mojada."
    },
    {
      "s": 77.57,
      "e": 80.39,
      "t": "Deja que se aflojen por completo."
    },
    {
      "s": 101.52,
      "e": 103.43,
      "t": "Las plantas de los pies."
    },
    {
      "s": 104.23,
      "e": 107.21,
      "t": "Los talones, hundiéndose en el colchón."
    },
    {
      "s": 108.01,
      "e": 109.92,
      "t": "Los tobillos, sueltos."
    },
    {
      "s": 131.04,
      "e": 137.55,
      "t": "Siente cómo una sensación de calor agradable sube desde los pies hacia las pantorrillas."
    },
    {
      "s": 138.35,
      "e": 140.67,
      "t": "Las pantorrillas se aflojan."
    },
    {
      "s": 141.47,
      "e": 142.27,
      "t": "Pesan."
    },
    {
      "s": 163.4,
      "e": 164.66,
      "t": "Las rodillas."
    },
    {
      "s": 165.46,
      "e": 171.04,
      "t": "Y los muslos, largos y pesados, completamente entregados a la cama."
    },
    {
      "s": 192.16,
      "e": 194.92,
      "t": "Tus piernas están descansando."
    },
    {
      "s": 195.72,
      "e": 198.21,
      "t": "No tienen que ir a ningún lado."
    },
    {
      "s": 240.46,
      "e": 242.79,
      "t": "Ahora la cadera, la pelvis."
    },
    {
      "s": 243.59,
      "e": 246.65,
      "t": "Siente cómo se asientan en el colchón."
    },
    {
      "s": 247.45,
      "e": 252.23,
      "t": "La parte baja de la espalda se suaviza con cada exhalación."
    },
    {
      "s": 273.36,
      "e": 277.28,
      "t": "El abdomen, subiendo y bajando, lento, tranquilo."
    },
    {
      "s": 278.08,
      "e": 279.84,
      "t": "Deja que se afloje."
    },
    {
      "s": 280.64,
      "e": 282.79,
      "t": "No hay nada que sostener."
    },
    {
      "s": 303.92,
      "e": 304.96,
      "t": "El pecho."
    },
    {
      "s": 305.76,
      "e": 309.62,
      "t": "La respiración, cada vez más suave, más lenta."
    },
    {
      "s": 330.74,
      "e": 335.68,
      "t": "La espalda completa, vértebra por vértebra, se hunde en la cama."
    },
    {
      "s": 336.48,
      "e": 338.94,
      "t": "Como si el colchón te abrazara."
    },
    {
      "s": 381.19,
      "e": 383.62,
      "t": "Lleva la atención a las manos."
    },
    {
      "s": 384.42,
      "e": 386.2,
      "t": "Las palmas, tibias."
    },
    {
      "s": 387.0,
      "e": 389.63,
      "t": "Los dedos, pesados y quietos."
    },
    {
      "s": 410.76,
      "e": 412.24,
      "t": "Los antebrazos."
    },
    {
      "s": 413.04,
      "e": 414.11,
      "t": "Los codos."
    },
    {
      "s": 414.91,
      "e": 420.3,
      "t": "Los brazos, pesados, tan pesados que sería un esfuerzo levantarlos."
    },
    {
      "s": 441.43,
      "e": 442.52,
      "t": "Los hombros."
    },
    {
      "s": 443.32,
      "e": 446.38,
      "t": "Déjalos caer, lejos de las orejas."
    },
    {
      "s": 447.18,
      "e": 453.45,
      "t": "Todo el peso del día se desliza por los brazos y sale por las puntas de los dedos."
    },
    {
      "s": 495.7,
      "e": 497.28,
      "t": "El cuello, suave."
    },
    {
      "s": 498.08,
      "e": 499.98,
      "t": "La nuca, apoyada."
    },
    {
      "s": 500.78,
      "e": 502.7,
      "t": "La mandíbula, suelta."
    },
    {
      "s": 503.5,
      "e": 505.95,
      "t": "Los labios apenas separados."
    },
    {
      "s": 506.75,
      "e": 508.68,
      "t": "La lengua descansando."
    },
    {
      "s": 529.8,
      "e": 531.1,
      "t": "Las mejillas."
    },
    {
      "s": 531.9,
      "e": 534.96,
      "t": "Los ojos, pesados bajo los párpados."
    },
    {
      "s": 535.76,
      "e": 539.05,
      "t": "El espacio entre las cejas, amplio y liso."
    },
    {
      "s": 560.18,
      "e": 562.76,
      "t": "La frente, fresca y serena."
    },
    {
      "s": 563.56,
      "e": 566.29,
      "t": "Y el cuero cabelludo, relajado."
    },
    {
      "s": 608.54,
      "e": 611.43,
      "t": "Ahora siente todo tu cuerpo a la vez."
    },
    {
      "s": 612.23,
      "e": 613.12,
      "t": "Pesado."
    },
    {
      "s": 613.92,
      "e": 614.71,
      "t": "Tibio."
    },
    {
      "s": 615.51,
      "e": 616.29,
      "t": "Quieto."
    },
    {
      "s": 617.09,
      "e": 620.9,
      "t": "Una sola ola de descanso, de la cabeza a los pies."
    },
    {
      "s": 684.28,
      "e": 689.46,
      "t": "Si aparece algún pensamiento, déjalo pasar como una nube lejana."
    },
    {
      "s": 690.26,
      "e": 692.17,
      "t": "No tienes que seguirlo."
    },
    {
      "s": 692.97,
      "e": 695.88,
      "t": "Vuelve a sentir el peso del cuerpo."
    },
    {
      "s": 696.68,
      "e": 698.6,
      "t": "La respiración lenta."
    },
    {
      "s": 783.1,
      "e": 784.63,
      "t": "Estás a salvo."
    },
    {
      "s": 785.43,
      "e": 786.89,
      "t": "Todo está bien."
    },
    {
      "s": 787.69,
      "e": 789.03,
      "t": "Puedes soltar."
    },
    {
      "s": 894.66,
      "e": 896.0,
      "t": "Que descanses."
    }
  ],
  "cues": []
}
