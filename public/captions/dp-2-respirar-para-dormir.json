  "captions": [
    {
      "s": 1.2,
      "e": 1.82,
      "t": "Hola."
    },
    {
      "s": 2.62,
      "e": 6.21,
      "t": "Esta es la segunda noche de Dormir profundo."
    },
    {
      "s": 7.01,
      "e": 10.99,
      "t": "Hoy vamos a usar la respiración como un interruptor."
    },
    {
      "s": 11.79,
      "e": 19.77,
      "t": "Cuando alargamos la exhalación, el cuerpo recibe una señal muy clara: estás a salvo, puedes descansar."
    },
    {
      "s": 22.77,
      "e": 26.4,
      "t": "Acuéstate en tu postura favorita para dormir."
    },
    {
      "s": 27.2,
      "e": 30.36,
      "t": "Deja que la cabeza pese sobre la almohada."
    },
    {
      "s": 35.36,
      "e": 40.87,
      "t": "Vamos a practicar una respiración conocida como cuatro, siete, ocho."
    },
    {
      "s": 41.67,
      "e": 44.88,
      "t": "Inhalas por la nariz contando hasta cuatro."
    },
    {
      "s": 45.68,
      "e": 48.86,
      "t": "Retienes el aire contando hasta siete."
    },
    {
      "s": 49.66,
      "e": 54.21,
      "t": "Y exhalas por la boca, muy despacio, contando hasta ocho."
    },
    {
      "s": 55.01,
      "e": 59.53,
      "t": "No te preocupes si al principio no llegas a esos números."
    },
    {
      "s": 60.33,
      "e": 62.76,
      "t": "Adapta el ritmo a tu cuerpo."
    },
    {
      "s": 63.56,
      "e": 68.43,
      "t": "Lo importante es que la exhalación sea más larga que la inhalación."
    },
    {
      "s": 71.43,
      "e": 72.62,
      "t": "Comenzamos."
    },
    {
