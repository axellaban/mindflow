{
  "id": "dp-1-soltar-el-dia",
  "voice": "luz",
  "duration": 720.0,
  "captions": [
    {
      "s": 1.2,
      "e": 1.82,
      "t": "Hola."
    },
    {
      "s": 2.62,
      "e": 6.56,
      "t": "Bienvenida a la primera noche de Dormir profundo."
    },
    {
      "s": 7.36,
      "e": 13.44,
      "t": "Esta práctica está pensada para escucharla ya en la cama, con las luces apagadas."
    },
    {
      "s": 14.24,
      "e": 17.33,
      "t": "No tienes que hacer nada más que escuchar."
    },
    {
      "s": 18.13,
      "e": 23.19,
      "t": "Si te duermes antes de que termine, perfecto: ese es el objetivo."
    },
    {
      "s": 26.19,
      "e": 29.9,
      "t": "Acomódate en la posición en la que sueles dormir."
    },
    {
      "s": 30.7,
      "e": 33.1,
      "t": "Ajusta la almohada, la manta."
    },
    {
      "s": 33.9,
      "e": 37.78,
      "t": "Date permiso para encontrar la comodidad de verdad."
    },
    {
      "s": 42.78,
      "e": 46.46,
      "t": "Haz una respiración lenta, llenando el abdomen…"
    },
    {
      "s": 49.46,
      "e": 55.85,
      "t": "y deja salir el aire muy despacio, como si soplaras sobre una vela sin apagarla."
    },
    {
      "s": 60.85,
      "e": 61.88,
      "t": "Otra vez."
    },
    {
      "s": 62.68,
      "e": 63.47,
      "t": "Inhala…"
    },
    {
      "s": 66.47,
      "e": 69.1,
      "t": "y una exhalación larga, larga."
    },
    {
      "s": 75.1,
      "e": 79.21,
      "t": "Deja que la respiración se vuelva lenta por sí sola."
    },
    {
      "s": 126.77,
      "e": 128.79,
      "t": "El día de hoy ya pasó."
    },
    {
      "s": 129.59,
      "e": 132.66,
      "t": "Hiciste lo que pudiste con lo que tenías."
    },
    {
      "s": 133.46,
      "e": 136.18,
      "t": "Ahora no hay nada más que resolver."
    },
    {
      "s": 136.98,
      "e": 142.59,
      "t": "Vamos a recorrerlo suavemente, como quien hojea un libro antes de cerrarlo."
    },
    {
      "s": 166.37,
      "e": 168.94,
      "t": "Recuerda cómo empezó tu día."
    },
    {
      "s": 169.74,
      "e": 171.68,
      "t": "El momento de despertar."
    },
    {
      "s": 172.48,
      "e": 173.29,
      "t": "La luz."
    },
    {
      "s": 174.09,
      "e": 176.05,
      "t": "Lo primero que hiciste."
    },
    {
      "s": 176.85,
      "e": 179.39,
      "t": "No te detengas en los detalles."
    },
    {
      "s": 180.19,
      "e": 182.76,
      "t": "Solo deja que la imagen pase."
    },
    {
      "s": 230.32,
      "e": 231.98,
      "t": "Recorre la mañana."
    },
    {
      "s": 232.78,
      "e": 234.76,
      "t": "Las personas que viste."
    },
    {
      "s": 235.56,
      "e": 238.13,
      "t": "Los lugares por los que pasaste."
    },
    {
      "s": 238.93,
      "e": 243.33,
      "t": "Como si miraras un paisaje desde la ventanilla de un tren."
    },
    {
      "s": 290.88,
      "e": 291.87,
      "t": "La tarde."
    },
    {
      "s": 292.67,
      "e": 294.15,
      "t": "Lo que salió bien."
    },
    {
      "s": 294.95,
      "e": 297.95,
      "t": "Lo que quizás no salió como esperabas."
    },
    {
      "s": 298.75,
      "e": 302.05,
      "t": "Todo eso también puede quedarse atrás."
    },
    {
      "s": 302.85,
      "e": 309.3,
      "t": "Si aparece algo pendiente, imagina que lo anotas en una hoja y la dejas sobre la mesa."
    },
    {
      "s": 310.1,
      "e": 311.95,
      "t": "Mañana seguirá ahí."
    },
    {
      "s": 312.75,
      "e": 315.1,
      "t": "Esta noche no te necesita."
    },
    {
      "s": 362.66,
      "e": 364.32,
      "t": "Y ahora, la noche."
    },
    {
      "s": 365.12,
      "e": 366.5,
      "t": "Este momento."
    },
    {
      "s": 367.3,
      "e": 369.08,
      "t": "Tu cuerpo en la cama."
    },
    {
      "s": 392.86,
      "e": 396.0,
      "t": "Elige un pequeño momento bueno de hoy."
    },
    {
      "s": 396.8,
      "e": 398.5,
      "t": "Por mínimo que sea."
    },
    {
      "s": 399.3,
      "e": 404.25,
      "t": "Un café caliente, una conversación, un rayo de sol, una risa."
    },
    {
      "s": 405.05,
      "e": 407.35,
      "t": "Quédate con él un instante."
    },
    {
      "s": 408.15,
      "e": 411.47,
      "t": "Deja que su calidez se extienda por el pecho."
    },
    {
      "s": 482.81,
      "e": 486.17,
      "t": "Ahora imagina que cierras el libro del día."
    },
    {
      "s": 486.97,
      "e": 488.21,
      "t": "Suavemente."
    },
    {
      "s": 489.01,
      "e": 490.61,
      "t": "Hoy termina aquí."
    },
    {
      "s": 514.39,
      "e": 518.13,
      "t": "Siente el peso de tu cuerpo, entregado a la cama."
    },
    {
      "s": 518.93,
      "e": 520.54,
      "t": "Los pies pesados."
    },
    {
      "s": 521.34,
      "e": 523.17,
      "t": "Las piernas pesadas."
    },
    {
      "s": 523.97,
      "e": 526.49,
      "t": "Las manos, tibias y pesadas."
    },
    {
      "s": 527.29,
      "e": 531.15,
      "t": "Cada exhalación te hunde un poco más en el descanso."
    },
    {
      "s": 602.48,
      "e": 604.21,
      "t": "No hay nada que hacer."
    },
    {
      "s": 605.01,
      "e": 606.47,
      "t": "Nada que pensar."
    },
    {
      "s": 607.27,
      "e": 608.94,
      "t": "Nada que resolver."
    },
    {
      "s": 609.74,
      "e": 611.06,
      "t": "Solo respirar…"
    },
    {
      "s": 612.41,
      "e": 613.72,
      "t": "y descansar."
    },
    {
      "s": 708.84,
      "e": 713.76,
      "t": "Puedes seguir así, en silencio, dejándote llevar por el sueño."
    },
    {
      "s": 714.56,
      "e": 716.0,
      "t": "Buenas noches."
    }
  ],
  "cues": []
}
